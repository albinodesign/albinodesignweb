---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import Icon from '../components/Icon.astro';
import Footer from '../components/Footer.astro';
import site from '../content/site.json';
import home from '../content/pages/home.json';

const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY;
if (!web3formsKey) {
  throw new Error('PUBLIC_WEB3FORMS_KEY ist nicht definiert. Bitte in .env setzen.');
}

const errorContactHtml = `${home.formSection.errorContactPre} <a href="tel:${site.phone}" class="underline">${site.phoneFormatted}</a>.`;
const trustIcons = ['shield', 'lock', 'rocket'] as const;
---

<Layout>
  <Fragment slot="head">
    <!-- Build refresh: force Cloudflare Pages rebuild -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "@id": "https://albinodesign.de/#business",
      "name": site.name,
      "description": home.meta.jsonLdDescription,
      "url": site.url,
      "image": "https://albinodesign.de/og-image.jpg",
      "telephone": site.phone,
      "email": site.email,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": site.street,
        "addressLocality": site.city,
        "postalCode": site.zip,
        "addressCountry": "DE"
      },
      "priceRange": "€",
      "founder": {
        "@type": "Person",
        "name": site.founder
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": home.faq.items.map((item) => ({
        "@type": "Question",
        "name": item.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.answer
        }
      }))
    })} />
  </Fragment>

<main id="main">
  <!-- 1. HERO SECTION -->
  <section class="relative min-h-[90dvh] flex flex-col justify-center bg-gradient-to-br from-dark via-primary to-secondary text-white overflow-hidden" aria-label="Hero" data-cms-section="hero">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(circle_at_top_right,_var(--color-accent)_0%,_transparent_60%)]"></div>
    
    <div class="relative z-10 w-full max-w-5xl mx-auto px-5 py-12 sm:py-20">
      <!-- Logo -->
      <div class="fade-in mb-8">
        <span class="text-2xl font-bold tracking-tight text-white">{site.name}{home.hero.logoSuffix}</span>
      </div>
      
      <!-- Headline -->
      <h1 class="fade-in fade-in-delay-1 text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight mb-6 text-balance" data-cms-field="hero.headline">
        {home.hero.headline}
      </h1>
      
      <!-- Sub-Headline -->
      <p class="fade-in fade-in-delay-2 text-lg sm:text-xl text-slate-300 mb-8 max-w-2xl text-balance" data-cms-field="hero.sublineHtml" set:html={home.hero.sublineHtml} />
      
      <!-- Trust Element -->
      <div class="fade-in fade-in-delay-3 flex items-center gap-4 mb-8">
        <div class="shrink-0">
          <img 
            src={home.hero.portrait.src} 
            alt={home.hero.portrait.alt} 
            width={home.hero.portrait.width} 
            height={home.hero.portrait.height} 
            class="w-16 h-16 sm:w-20 sm:h-20 rounded-full object-cover border-2 border-accent"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            data-cms-field="hero.portrait.src"
          />
        </div>
        <div>
          <p class="text-sm font-semibold text-white">{home.hero.trustName}</p>
          <p class="text-sm text-slate-400">{home.hero.trustRole}</p>
          <div class="flex items-center gap-1 mt-1" aria-label={home.hero.ratingAriaLabel}>
            <span class="text-accent text-xs" aria-hidden="true">★★★★★</span>
            <span class="text-xs text-slate-400">{home.hero.ratingText}</span>
          </div>
        </div>
      </div>
      
      <!-- Leitsatz -->
      <p class="fade-in fade-in-delay-3 text-lg sm:text-xl italic text-slate-200 mb-10 max-w-xl border-l-4 border-accent pl-4" data-cms-field="hero.quote">
        {home.hero.quote}
      </p>
      
      <!-- CTA -->
      <div class="fade-in fade-in-delay-4">
        <Button href="#formular" size="large" class="w-full sm:w-auto min-h-[56px] touch-manipulation">
          {home.hero.cta}
          <svg class="w-5 h-5 ml-2" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </Button>
        
        <!-- Trust-Bar -->
        <div class="mt-6 flex flex-wrap items-center justify-center sm:justify-start gap-x-6 gap-y-3" aria-label={home.hero.trustBarLabel}>
          {home.hero.trustItems.map((item, index) => (
            <div class="flex items-center gap-2 text-slate-400">
              <Icon name={trustIcons[index]} class="w-5 h-5 text-slate-500" />
              <span class="text-sm font-medium" data-cms-field={`hero.trustItems.${index}`}>{item}</span>
            </div>
          ))}
        </div>
        
        <p class="mt-3 text-sm text-slate-400" data-cms-field="hero.ctaNote">{home.hero.ctaNote}</p>
      </div>
    </div>
  </section>

  <!-- 2. PROBLEM-AGITATION SECTION -->
  <section class="bg-dark text-white py-16 sm:py-24" aria-labelledby="problem-heading" data-cms-section="problem">
    <div class="max-w-4xl mx-auto px-5">
      <h2 id="problem-heading" class="text-2xl sm:text-3xl font-bold mb-10 text-center text-balance" data-cms-field="problem.heading">
        {home.problem.heading}
      </h2>
      
      <div class="space-y-6">
        {home.problem.items.map((item, index) => (
          <div class="flex items-start gap-4 bg-secondary/50 rounded-xl p-5 border border-slate-700">
            <span class="text-2xl shrink-0" aria-hidden="true">❌</span>
            <p class="text-slate-200 leading-relaxed" data-cms-field={`problem.items.${index}`}>
              {item}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. PORTFOLIO & SOCIAL PROOF SECTION -->
  <section class="bg-light py-16 sm:py-24" aria-labelledby="portfolio-heading" data-cms-section="portfolio">
    <div class="max-w-7xl mx-auto px-5">
      <h2 id="portfolio-heading" class="text-2xl sm:text-3xl font-bold mb-4 text-center text-balance" data-cms-field="portfolio.heading">
        {home.portfolio.heading}
      </h2>
      <p class="text-muted text-center mb-12 max-w-2xl mx-auto" data-cms-field="portfolio.subline">{home.portfolio.subline}</p>
      
      <!-- Portfolio Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8 mb-16">
        {home.portfolio.references.map((ref, index) => (
          <Card class="flex flex-col">
            <div slot="header" class="overflow-hidden rounded-t-2xl -mt-6 -mx-6 mb-5">
              <img 
                src={ref.image.src} 
                srcset={ref.image.srcset}
                sizes={ref.image.sizes}
                alt={ref.image.alt} 
                width={ref.image.width} 
                height={ref.image.height}
                class="w-full h-auto"
                loading="lazy"
                decoding="async"
                data-cms-field={`portfolio.references.${index}.image.src`}
              />
            </div>
            
            <!-- Kunden-Info -->
            <div class="flex items-center gap-3 mb-4">
              <img 
                src={ref.logo.src} 
                alt={ref.logo.alt} 
                width={ref.logo.width} 
                height={ref.logo.height}
                class="w-12 h-12 rounded-full object-cover border border-slate-200 bg-white"
                loading="lazy"
                decoding="async"
              />
              <div>
                <p class="font-semibold text-primary">{ref.name}</p>
                <p class="text-sm text-muted">{ref.person}</p>
              </div>
            </div>
            
            <!-- Review-Screenshot -->
            <div class="mb-5">
              <img 
                src={ref.review.src} 
                alt={ref.review.alt} 
                width={ref.review.width} 
                height={ref.review.height}
                class="rounded-xl shadow-sm border border-slate-100 w-full h-auto"
                loading="lazy"
                decoding="async"
              />
            </div>
            
            <div class="mt-auto pt-2 flex justify-center">
              <Button href={ref.url} variant="outline" target="_blank" rel="noopener noreferrer" class="min-h-[56px] touch-manipulation">
                {home.portfolio.buttonLabel}
                <Icon name="external-link" class="w-4 h-4 ml-2" />
              </Button>
            </div>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. ÜBER MICH SECTION -->
  <section class="bg-white py-16 sm:py-24" aria-labelledby="about-heading" data-cms-section="about">
    <div class="max-w-4xl mx-auto px-5">
      <div class="bg-gradient-to-br from-light to-white rounded-3xl p-6 sm:p-10 shadow-lg border border-slate-100">
        <div class="flex flex-col md:flex-row gap-8 items-center">
          <div class="shrink-0">
            <img 
              src={home.about.image.src} 
              srcset={home.about.image.srcset}
              sizes={home.about.image.sizes}
              alt={home.about.image.alt} 
              width={home.about.image.width} 
              height={home.about.image.height}
              class="w-64 sm:w-80 rounded-2xl shadow-xl h-auto"
              loading="lazy"
              decoding="async"
              data-cms-field="about.image.src"
            />
          </div>
          
          <div class="flex-1 text-center md:text-left">
            <h2 id="about-heading" class="text-2xl sm:text-3xl font-bold mb-4 text-balance" data-cms-field="about.heading">
              {home.about.heading}
            </h2>
            <div class="w-16 h-1 bg-accent rounded-full mb-6 mx-auto md:mx-0"></div>
            <p class="text-primary leading-relaxed mb-4" data-cms-field="about.paragraph1">
              {home.about.paragraph1}
            </p>
            <p class="text-primary leading-relaxed" data-cms-field="about.paragraph2">
              {home.about.paragraph2}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. 3-SCHRITTE-PROZESS SECTION -->
  <section class="bg-light py-16 sm:py-24" aria-labelledby="process-heading" data-cms-section="process">
    <div class="max-w-4xl mx-auto px-5">
      <h2 id="process-heading" class="text-2xl sm:text-3xl font-bold mb-12 text-center text-balance" data-cms-field="process.heading">
        {home.process.heading}
      </h2>
      
      <div class="space-y-6">
        {home.process.steps.map((step, index) => (
          <Card hover class="flex items-start gap-5">
            <div class="shrink-0 w-14 h-14 bg-accent/10 rounded-xl flex items-center justify-center text-2xl" aria-hidden="true">
              {step.icon}
            </div>
            <div>
              <h3 class="text-xl font-bold mb-2" data-cms-field={`process.steps.${index}.title`}>{step.title}</h3>
              <p class="text-muted leading-relaxed" data-cms-field={`process.steps.${index}.text`}>{step.text}</p>
            </div>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. MULTI-STEP FORMULAR (CRO HERZSTÜCK) -->
  <section id="formular" class="bg-gradient-to-b from-secondary to-dark py-16 sm:py-24" aria-labelledby="form-heading" data-cms-section="formular">
    <div class="max-w-2xl mx-auto px-5">
      <div class="text-center mb-10">
        <h2 id="form-heading" class="text-2xl sm:text-3xl font-bold text-white mb-3 text-balance" data-cms-field="formSection.heading">
          {home.formSection.heading}
        </h2>
        <p class="text-slate-300" data-cms-field="formSection.subline">{home.formSection.subline}</p>
      </div>
      
      <!-- Garantie-Box -->
      <div class="mb-6 bg-white/10 border border-white/10 rounded-2xl p-5 sm:p-6 backdrop-blur-sm">
        <div class="flex items-start gap-4">
          <div class="shrink-0 w-10 h-10 bg-accent/20 rounded-full flex items-center justify-center" aria-hidden="true">
            <Icon name="check" class="w-6 h-6 text-accent" />
          </div>
          <div>
            <h3 class="text-lg font-bold text-white mb-1" data-cms-field="formSection.guaranteeTitle">{home.formSection.guaranteeTitle}</h3>
            <p class="text-sm sm:text-base text-slate-300 leading-relaxed" data-cms-field="formSection.guaranteeText">
              {home.formSection.guaranteeText}
            </p>
          </div>
        </div>
      </div>
      
      <div class="bg-white rounded-3xl shadow-2xl p-6 sm:p-10">
        <!-- Form Error Message -->
        <div id="form-error" class="hidden text-center py-6 mb-4 bg-red-50 border border-red-200 rounded-2xl" role="alert" aria-live="polite">
          <p class="text-red-600 font-medium">{home.formSection.errorTitle}</p>
          <p class="text-red-500 text-sm mt-1" set:html={errorContactHtml} />
        </div>
        
        <!-- Live region for validation errors -->
        <div id="form-validation-live" class="sr-only" aria-live="polite" aria-atomic="true"></div>
        
        <!-- No-JS Fallback -->
        <noscript>
          <style>
            #multi-step-form .form-step.hidden { display: block !important; }
            #multi-step-form .step-next,
            #multi-step-form .step-prev { display: none !important; }
            #form-progress { display: none !important; }
          </style>
          <p class="text-sm text-muted mb-4 bg-amber-50 border border-amber-200 rounded-xl p-3">
            {home.formSection.noJsNote}
          </p>
        </noscript>
        
        <!-- Form -->
        <form id="multi-step-form" action="https://api.web3forms.com/submit" method="POST" class="space-y-8" novalidate>
          <!-- Honeypot -->
          <input type="checkbox" name="botcheck" class="hidden" style="display: none;" tabindex="-1" autocomplete="off" />
          
          <!-- Web3Forms Access Key -->
          <input type="hidden" name="access_key" value={web3formsKey} />
          
          <!-- GCLID Tracking -->
          <input type="hidden" name="gclid" id="gclid_field" value="" />
          
          <!-- Subject -->
          <input type="hidden" name="subject" value="Neue Website-Anfrage von AlbinoDesign Landingpage" />
          <input type="hidden" name="from_name" value="AlbinoDesign Landingpage" />
          
          <!-- Step 1: Gewerk -->
          <div id="step-1" class="form-step" data-step="1">
            <fieldset class="space-y-3">
              <legend class="text-lg font-semibold mb-4">Welches Gewerk üben Sie aus?</legend>
              <div class="space-y-3">
                <label class="flex items-center gap-3 p-4 border-2 border-slate-200 rounded-xl cursor-pointer hover:border-accent transition-colors has-[:checked]:border-accent has-[:checked]:bg-accent/5">
                  <input type="radio" name="gewerk" value="Sanitär & Heizung" class="w-5 h-5 text-accent accent-accent" required />
                  <span class="font-medium">Sanitär & Heizung</span>
                </label>
                <label class="flex items-center gap-3 p-4 border-2 border-slate-200 rounded-xl cursor-pointer hover:border-accent transition-colors has-[:checked]:border-accent has-[:checked]:bg-accent/5">
                  <input type="radio" name="gewerk" value="Elektro" class="w-5 h-5 text-accent accent-accent" />
                  <span class="font-medium">Elektro</span>
                </label>
                <label class="flex items-center gap-3 p-4 border-2 border-slate-200 rounded-xl cursor-pointer hover:border-accent transition-colors has-[:checked]:border-accent has-[:checked]:bg-accent/5">
                  <input type="radio" name="gewerk" value="Dachdecker" class="w-5 h-5 text-accent accent-accent" />
                  <span class="font-medium">Dachdecker</span>
                </label>
                <label class="flex items-center gap-3 p-4 border-2 border-slate-200 rounded-xl cursor-pointer hover:border-accent transition-colors has-[:checked]:border-accent has-[:checked]:bg-accent/5">
                  <input type="radio" name="gewerk" value="Maler" class="w-5 h-5 text-accent accent-accent" />
                  <span class="font-medium">Maler</span>
                </label>
                <label class="flex items-center gap-3 p-4 border-2 border-slate-200 rounded-xl cursor-pointer hover:border-accent transition-colors has-[:checked]:border-accent has-[:checked]:bg-accent/5">
                  <input type="radio" name="gewerk" value="Sonstiges" class="w-5 h-5 text-accent accent-accent" />
                  <span class="font-medium">Sonstiges</span>
                </label>
              </div>
            </fieldset>
            <p class="text-red-500 text-sm mt-2 hidden" id="error-step-1" role="alert">Bitte wählen Sie ein Gewerk aus.</p>
            <div class="mt-6">
              <button type="button" class="step-next w-full bg-accent text-white font-semibold py-4 px-6 rounded-xl hover:bg-accent-hover transition-colors min-h-[56px] touch-manipulation active:scale-[0.98]" data-next="2">
                Weiter
              </button>
            </div>
          </div>
          
          <!-- Step 2: Hauptziel -->
          <div id="step-2" class="form-step hidden" data-step="2">
            <fieldset class="space-y-3">
              <legend class="text-lg font-semibold mb-4">Was ist Ihr Hauptziel?</legend>
              <div class="space-y-3">
                <label class="flex items-center gap-3 p-4 border-2 border-slate-200 rounded-xl cursor-pointer hover:border-accent transition-colors has-[:checked]:border-accent has-[:checked]:bg-accent/5">
                  <input type="radio" name="ziel" value="Neue lukrative Aufträge" class="w-5 h-5 text-accent accent-accent" required />
                  <span class="font-medium">Neue lukrative Aufträge gewinnen</span>
                </label>
                <label class="flex items-center gap-3 p-4 border-2 border-slate-200 rounded-xl cursor-pointer hover:border-accent transition-colors has-[:checked]:border-accent has-[:checked]:bg-accent/5">
                  <input type="radio" name="ziel" value="Fachkräfte & Azubis finden" class="w-5 h-5 text-accent accent-accent" />
                  <span class="font-medium">Fachkräfte & Azubis finden</span>
                </label>
                <label class="flex items-center gap-3 p-4 border-2 border-slate-200 rounded-xl cursor-pointer hover:border-accent transition-colors has-[:checked]:border-accent has-[:checked]:bg-accent/5">
                  <input type="radio" name="ziel" value="Professioneller Internet-Auftritt" class="w-5 h-5 text-accent accent-accent" />
                  <span class="font-medium">Professioneller Internet-Auftritt</span>
                </label>
              </div>
            </fieldset>
            <p class="text-red-500 text-sm mt-2 hidden" id="error-step-2" role="alert">Bitte wählen Sie ein Ziel aus.</p>
            <div class="mt-6 flex gap-3">
              <button type="button" class="step-prev flex-1 bg-secondary text-white font-semibold py-4 px-6 rounded-xl hover:bg-primary transition-colors min-h-[56px] touch-manipulation active:scale-[0.98]" data-prev="1">
                Zurück
              </button>
              <button type="button" class="step-next flex-1 bg-accent text-white font-semibold py-4 px-6 rounded-xl hover:bg-accent-hover transition-colors min-h-[56px] touch-manipulation active:scale-[0.98]" data-next="3">
                Weiter
              </button>
            </div>
          </div>
          
          <!-- Step 3: Bestehende Website -->
          <div id="step-3" class="form-step hidden" data-step="3">
            <fieldset class="space-y-3">
              <legend class="text-lg font-semibold mb-4">Haben Sie bereits eine Website?</legend>
              <div class="space-y-3">
                <label class="flex items-center gap-3 p-4 border-2 border-slate-200 rounded-xl cursor-pointer hover:border-accent transition-colors has-[:checked]:border-accent has-[:checked]:bg-accent/5">
                  <input type="radio" name="website_vorhanden" value="Ja" class="w-5 h-5 text-accent accent-accent" required />
                  <span class="font-medium">Ja</span>
                </label>
                <label class="flex items-center gap-3 p-4 border-2 border-slate-200 rounded-xl cursor-pointer hover:border-accent transition-colors has-[:checked]:border-accent has-[:checked]:bg-accent/5">
                  <input type="radio" name="website_vorhanden" value="Nein" class="w-5 h-5 text-accent accent-accent" />
                  <span class="font-medium">Nein</span>
                </label>
              </div>
            </fieldset>
            <p class="text-red-500 text-sm mt-2 hidden" id="error-step-3" role="alert">Bitte treffen Sie eine Auswahl.</p>
            <div class="mt-6 flex gap-3">
              <button type="button" class="step-prev flex-1 bg-secondary text-white font-semibold py-4 px-6 rounded-xl hover:bg-primary transition-colors min-h-[56px] touch-manipulation active:scale-[0.98]" data-prev="2">
                Zurück
              </button>
              <button type="button" class="step-next flex-1 bg-accent text-white font-semibold py-4 px-6 rounded-xl hover:bg-accent-hover transition-colors min-h-[56px] touch-manipulation active:scale-[0.98]" data-next="4">
                Weiter
              </button>
            </div>
          </div>
          
          <!-- Step 4: Kontaktdaten -->
          <div id="step-4" class="form-step hidden" data-step="4">
            <h3 class="text-lg font-semibold mb-4">Fast geschafft! Wie kann ich Sie erreichen, um die Details für den Entwurf zu besprechen?</h3>
            <div class="space-y-4">
              <div>
                <label for="name" class="block text-sm font-medium mb-1.5">Ihr Name</label>
                <input 
                  type="text" 
                  id="name" 
                  name="name" 
                  required 
                  autocomplete="name"
                  aria-required="true"
                  aria-describedby="error-name"
                  aria-invalid="false"
                  class="w-full px-4 py-3.5 border-2 border-slate-200 rounded-xl focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 transition-colors min-h-[56px]"
                  placeholder="Max Mustermann"
                />
                <p class="text-red-500 text-sm mt-1 hidden" id="error-name" role="alert">Bitte geben Sie Ihren Namen ein.</p>
              </div>
              
              <div>
                <label for="email" class="block text-sm font-medium mb-1.5">E-Mail-Adresse</label>
                <input 
                  type="email" 
                  id="email" 
                  name="email" 
                  required
                  autocomplete="email"
                  aria-required="true"
                  aria-describedby="error-email"
                  aria-invalid="false"
                  class="w-full px-4 py-3.5 border-2 border-slate-200 rounded-xl focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 transition-colors min-h-[56px]"
                  placeholder="max@beispiel.de"
                />
                <p class="text-red-500 text-sm mt-1 hidden" id="error-email" role="alert">Bitte geben Sie eine gültige E-Mail-Adresse ein.</p>
              </div>
              
              <div>
                <label for="telefon" class="block text-sm font-medium mb-1.5">Handynummer</label>
                <input 
                  type="tel" 
                  id="telefon" 
                  name="telefon" 
                  required 
                  autocomplete="tel"
                  inputmode="tel"
                  aria-required="true"
                  aria-describedby="error-telefon"
                  aria-invalid="false"
                  class="w-full px-4 py-3.5 border-2 border-slate-200 rounded-xl focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 transition-colors min-h-[56px]"
                  placeholder="+49 176 12345678"
                />
                <p class="text-red-500 text-sm mt-1 hidden" id="error-telefon" role="alert">Bitte geben Sie Ihre Handynummer ein.</p>
              </div>
            </div>
            
            <div class="mt-4 p-4 bg-slate-50 rounded-xl text-sm text-muted">
              <label class="flex items-start gap-3 cursor-pointer">
                <input 
                  type="checkbox" 
                  name="datenschutz" 
                  id="datenschutz" 
                  required 
                  class="mt-0.5 w-5 h-5 text-accent accent-accent shrink-0"
                  aria-required="true"
                  aria-describedby="error-datenschutz"
                />
                <span>
                  Ich stimme der Verarbeitung meiner Daten gemäß der <a href="/datenschutz" class="text-accent underline hover:no-underline">Datenschutzerklärung</a> zu.
                </span>
              </label>
              <p class="text-red-500 text-sm mt-1 hidden" id="error-datenschutz" role="alert">Bitte akzeptieren Sie die Datenschutzerklärung.</p>
            </div>
            
            <div class="mt-6 flex gap-3">
              <button type="button" class="step-prev flex-1 bg-secondary text-white font-semibold py-4 px-6 rounded-xl hover:bg-primary transition-colors min-h-[56px] touch-manipulation active:scale-[0.98]" data-prev="3">
                Zurück
              </button>
              <button type="submit" class="flex-1 bg-accent text-white font-bold py-4 px-6 rounded-xl hover:bg-accent-hover transition-colors min-h-[56px] touch-manipulation shadow-lg shadow-accent/25 active:scale-[0.98]">
                Jetzt anfordern
              </button>
            </div>
          </div>
          
          <!-- Progress Indicator -->
          <div class="flex justify-center gap-2 sm:gap-3 pt-4" id="form-progress" aria-hidden="true">
            <span class="w-10 h-2.5 sm:w-12 sm:h-3 rounded-full bg-accent transition-colors" data-indicator="1"></span>
            <span class="w-10 h-2.5 sm:w-12 sm:h-3 rounded-full bg-slate-200 transition-colors" data-indicator="2"></span>
            <span class="w-10 h-2.5 sm:w-12 sm:h-3 rounded-full bg-slate-200 transition-colors" data-indicator="3"></span>
            <span class="w-10 h-2.5 sm:w-12 sm:h-3 rounded-full bg-slate-200 transition-colors" data-indicator="4"></span>
          </div>
        </form>
      </div>
    </div>
  </section>

  <!-- 7. FAQ SECTION -->
  <section class="bg-light py-16 sm:py-24" aria-labelledby="faq-heading" data-cms-section="faq">
    <div class="max-w-3xl mx-auto px-5">
      <h2 id="faq-heading" class="text-2xl sm:text-3xl font-bold mb-10 text-center" data-cms-field="faq.heading">
        {home.faq.heading}
      </h2>
      
      <div class="space-y-4">
        {home.faq.items.map((item, index) => (
          <details class="group bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
            <summary class="flex items-center justify-between p-5 cursor-pointer list-none font-semibold text-primary hover:bg-slate-50 transition-colors min-h-[56px] focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:bg-slate-50 rounded-2xl">
              <span data-cms-field={`faq.items.${index}.question`}>{item.question}</span>
              <span class="ml-4 shrink-0 text-accent transition-transform group-open:rotate-180" aria-hidden="true">
                <svg class="w-5 h-5" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </span>
            </summary>
            <div class="px-5 pt-4 pb-5 text-muted leading-relaxed" data-cms-field={`faq.items.${index}.answer`}>
              {item.answer}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
</main>

  <Footer />

  <script src="/scripts/form.js" is:inline defer></script>
</Layout>
