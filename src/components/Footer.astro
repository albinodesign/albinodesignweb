---
import site from '../data/site.json';
---

<footer class="bg-dark text-slate-400 py-10" role="contentinfo">
  <div class="max-w-4xl mx-auto px-5 text-center">
    <p class="text-sm mb-4">
      © {new Date().getFullYear()} {site.name}. Alle Rechte vorbehalten.
    </p>
    <div class="flex items-center justify-center gap-4 text-sm flex-wrap">
      <a href="/impressum" class="hover:text-white transition-colors underline underline-offset-2">Impressum</a>
      <span aria-hidden="true">|</span>
      <a href="/datenschutz" class="hover:text-white transition-colors underline underline-offset-2">Datenschutz</a>
      <span aria-hidden="true">|</span>
      <button type="button" onclick="if(window.showCookieBanner)window.showCookieBanner()" class="hover:text-white transition-colors underline underline-offset-2 bg-transparent border-none cursor-pointer p-0 text-inherit font-inherit">Cookie-Einstellungen</button>
    </div>
    
    <div class="mt-6 pt-6 border-t border-slate-800 text-xs text-slate-400 space-y-1">
      <p>{site.name} · {site.founder}</p>
      <p>{site.street}, {site.zip} {site.city}</p>
      <p>Tel: <a href={`tel:${site.phone}`} class="hover:text-slate-400 transition-colors">{site.phoneFormatted}</a> · E-Mail: <a href={`mailto:${site.email}`} class="hover:text-slate-400 transition-colors">{site.email}</a></p>
    </div>
  </div>
</footer>
