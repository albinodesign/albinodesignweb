---
export interface Props {
  class?: string;
  hover?: boolean;
}

const { class: className = '', hover = false } = Astro.props;

const baseClasses = 'bg-white rounded-2xl p-6 shadow-md border border-slate-100';
const hoverClasses = hover ? 'transition-all duration-300 hover:shadow-xl hover:-translate-y-1' : '';
const classes = `${baseClasses} ${hoverClasses} ${className}`;
---

<div class={classes}>
  <slot />
</div>
