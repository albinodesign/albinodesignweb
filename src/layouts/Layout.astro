---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  robots?: string;
  canonical?: boolean;
}

const { 
  title = "AlbinoDesign | Moderne Handwerker-Websites in 3 Tagen",
  description = "Gewinnen Sie mehr lukrative Aufträge und qualifizierte Azubis mit einer professionellen Website. Schlüsselfertig für einmalig 999 €. Albin Salihu aus Krefeld.",
  ogImage = "https://albinodesign.de/og-image.jpg",
  robots = "index, follow",
  canonical = true
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://albinodesign.de/');
---

<!DOCTYPE html>
<html lang="de" dir="ltr">
  <head>
    <!-- Google Tag Manager — DSGVO-konform, erst nach Cookie-Consent aktiv -->
    <script type="text/plain" data-cookiecategory="analytics">
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-MDB35QMG');
    </script>
    <!-- End Google Tag Manager -->
    
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="AlbinoDesign" />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#0f172a" />
    
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="AlbinoDesign – Moderne Handwerker-Websites in 3 Tagen" />
    <meta property="og:site_name" content="AlbinoDesign" />
    <meta property="og:locale" content="de_DE" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    
    {canonical && <link rel="canonical" href={canonicalURL} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    
    <title>{title}</title>
    
    <link rel="preload" href="/fonts/Inter-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Inter-Bold.woff2" as="font" type="font/woff2" crossorigin />
    
    <link rel="preconnect" href="https://api.web3forms.com" crossorigin />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
    
    <style is:inline>
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('/fonts/Inter-Regular.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 500;
        font-display: swap;
        src: url('/fonts/Inter-Medium.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 600;
        font-display: swap;
        src: url('/fonts/Inter-SemiBold.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url('/fonts/Inter-Bold.woff2') format('woff2');
      }
    </style>
    
    <style is:inline>
      /* Critical CSS for above-the-fold */
      .fade-in {
        animation: fadeIn 0.8s ease-out forwards;
        opacity: 0;
      }
      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
      }
      .fade-in-delay-1 { animation-delay: 0.15s; }
      .fade-in-delay-2 { animation-delay: 0.3s; }
      .fade-in-delay-3 { animation-delay: 0.45s; }
      .fade-in-delay-4 { animation-delay: 0.6s; }
      @media (prefers-reduced-motion: reduce) {
        .fade-in {
          animation: none;
          opacity: 1;
          transform: none;
        }
      }
      /* CMS-Auswahl: dezente Markierung des angeklickten Feldes in der Vorschau */
      [data-cms-highlight="true"] {
        outline: 2px solid #fa7315 !important;
        outline-offset: 3px;
        border-radius: 6px;
      }
    </style>
    
    <slot name="head" />
  </head>
  <body class="bg-light text-primary antialiased">
    <a href="#main" class="absolute -top-10 left-4 z-50 bg-accent text-white px-4 py-2 rounded-lg font-semibold transition-all focus:top-4 focus:ring-2 focus:ring-accent focus:ring-offset-2">
      Zum Inhalt springen
    </a>
    <!-- Google Tag Manager (noscript) — DSGVO-konform -->
    <noscript data-cookiecategory="analytics">
      <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MDB35QMG"
      height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->
    
    <slot />
    
    <!-- Cookie Banner -->
    <div id="cookie-banner" role="dialog" aria-modal="true" aria-live="polite" aria-label="Cookie Einwilligung" aria-describedby="cookie-banner-text" class="fixed bottom-0 left-0 right-0 z-50 bg-dark text-light p-4 shadow-2xl transform translate-y-full transition-transform duration-300" style="display: none;" tabindex="-1">
      <div class="max-w-4xl mx-auto flex flex-col sm:flex-row items-start sm:items-center gap-4">
        <div id="cookie-banner-text" class="flex-1 text-sm">
          <p class="mb-1">
            <strong>Datenschutz ist uns wichtig.</strong>
          </p>
          <p class="text-muted">
            Wir nutzen Cookies für die Basisfunktionen der Website. Optional können Sie der Erhebung anonymer Nutzungsdaten via Google Tag Manager zustimmen, um uns bei der Verbesserung der Website zu helfen.
          </p>
        </div>
        <div class="flex gap-3 shrink-0 w-full sm:w-auto">
          <button 
            id="cookie-decline" 
            type="button"
            class="flex-1 sm:flex-none px-4 py-3 text-sm font-medium text-light bg-secondary hover:bg-primary rounded-lg transition-colors active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2"
          >
            Ablehnen
          </button>
          <button 
            id="cookie-accept" 
            type="button"
            class="flex-1 sm:flex-none px-4 py-3 text-sm font-bold text-primary bg-accent hover:bg-accent-hover rounded-lg transition-colors active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2"
          >
            Akzeptieren
          </button>
        </div>
      </div>
    </div>
    
    <script src="/scripts/cookie-consent.js" is:inline defer></script>
    
    <!-- CMS Preview-Bridge: sichere Live-Vorschau fürs Agency-CMS (keine sichtbare Änderung) -->
    <script is:inline>
      (function () {
        var TRUSTED = [
          /^https:\/\/albinodesign\.de$/,
          /^https:\/\/([a-z0-9-]+\.)*vercel\.app$/,
          /^http:\/\/localhost(:\d+)?$/
        ];
        function trusted(origin) {
          if (origin === window.location.origin) return true;
          for (var i = 0; i < TRUSTED.length; i++) {
            if (TRUSTED[i].test(origin)) return true;
          }
          return false;
        }
        function validField(f) {
          return typeof f === 'string' && /^[a-z0-9][a-z0-9-]*$/.test(f) && f.length <= 80;
        }
        function clearHi() {
          document.querySelectorAll('[data-cms-highlight="true"]').forEach(function (el) {
            el.removeAttribute('data-cms-highlight');
          });
        }
        function hi(field) {
          clearHi();
          var t = document.querySelector('[data-cms-field="' + field + '"]');
          if (t) {
            t.setAttribute('data-cms-highlight', 'true');
            try { t.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
            catch (e) { t.scrollIntoView(); }
            setTimeout(clearHi, 2500);
          }
        }
        function apply(field, value) {
          if (!validField(field) || typeof value !== 'string') return;
          if (value.length > 5000) return;
          var nodes = document.querySelectorAll('[data-cms-field="' + field + '"]');
          if (!nodes.length) return;
          nodes.forEach(function (el) {
            var tag = el.tagName;
            if (tag === 'IMG' && /-src$|-image$/.test(field)) {
              el.setAttribute('src', value);
              el.removeAttribute('srcset');
              return;
            }
            if (/-alt$/.test(field)) {
              if (tag === 'IMG') el.setAttribute('alt', value);
              else el.textContent = value;
              return;
            }
            if (field === 'site-phone') {
              if (tag === 'A' && (el.getAttribute('href') || '').indexOf('tel:') === 0) {
                el.setAttribute('href', 'tel:' + value);
              } else { el.textContent = value; }
              document.querySelectorAll('a[href^="tel:"]:not([data-cms-field])').forEach(function (a) {
                a.setAttribute('href', 'tel:' + value);
              });
              return;
            }
            if (field === 'site-phone-formatted') { el.textContent = value; return; }
            if (field === 'site-email') {
              if (tag === 'A') {
                el.textContent = value;
                if ((el.getAttribute('href') || '').indexOf('mailto:') === 0) el.setAttribute('href', 'mailto:' + value);
              } else { el.textContent = value; }
              document.querySelectorAll('a[href^="mailto:"]:not([data-cms-field])').forEach(function (a) {
                a.setAttribute('href', 'mailto:' + value);
              });
              return;
            }
            if (field === 'home-hero-subline') { el.innerHTML = value; return; }
            el.textContent = value;
          });
        }
        var selectMode = false;
        document.addEventListener('click', function (e) {
          if (!selectMode) return;
          var m = e.target && e.target.closest ? e.target.closest('[data-cms-field]') : null;
          if (m) {
            e.preventDefault();
            e.stopPropagation();
            var f = m.getAttribute('data-cms-field');
            hi(f);
            try { window.parent.postMessage({ type: 'CMS_FIELD_SELECT', field: f }, '*'); } catch (err) {}
          }
        }, true);
        window.addEventListener('message', function (event) {
          if (!trusted(event.origin)) return;
          var d = event.data;
          if (!d || typeof d !== 'object') return;
          if (d.type === 'CMS_FIELD_UPDATE' && typeof d.field === 'string') apply(d.field, d.value);
          if ((d.type === 'CMS_FIELD_SELECT' || d.type === 'CMS_SCROLL_TO_FIELD') && typeof d.field === 'string') {
            if (validField(d.field)) hi(d.field);
          }
          if (d.type === 'CMS_SELECT_MODE') {
            selectMode = (d.enabled === true || d.value === true || d.active === true);
            document.body.style.cursor = selectMode ? 'pointer' : '';
          }
        });
        try { window.parent.postMessage({ type: 'CMS_PREVIEW_READY', url: window.location.href }, '*'); } catch (e) {}
      })();
    </script>
  </body>
</html>
